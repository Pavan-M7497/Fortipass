# Copy to .env and adjust for production
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET=use-same-or-different-long-secret
ENCRYPTION_KEY=exactly-32-chars-long-key!!1
# Optional: comma-separated origins (overrides default dev list)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
